{
  "appId": "com.bmusic.myapp",
  "productName": "his-voice",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraResources": [
    {
      "from": "resources/eodh",
      "to": "eodh",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "icon": "public/hisv.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "deleteAppDataOnUninstall": false,
    "include": "build/installer.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "codeDeSyntax",
    "repo": "hisv_desktop",
    "releaseType": "release"
  }
}
