/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  appId: "com.bmusic.myapp",
  productName: "his-voice",
  asar: true,
  directories: {
    output: "release/${version}",
  },
  files: ["dist-electron", "dist"],
  extraResources: [
    {
      from: "resources/eodh",
      to: "eodh",
      filter: ["**/*"],
    },
  ],
  win: {
    icon: "public/hisv.png",
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "${productName}_${version}.${ext}",
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    allowElevation: true,
    deleteAppDataOnUninstall: false,
    // Kill running process so app.asar isn’t locked during update install
    include: "build/installer.nsh",
  },
  publish: {
    provider: "github",
    owner: "codeDeSyntax",
    repo: "hisv_desktop",
    releaseType: "release",
  },
}
