{
  "name": "his-voice",
  "version": "1.0.32",
  "main": "dist-electron/main/index.js",
  "description": "Electron Vite React boilerplate.",
  "author": "dlcentimemessage>",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "preview": "vite preview",
    "build-db": "python scripts/siteandbuildscripts/build_sermons_db.py --output resources/sermons.db",
    "sermons:check": "python scripts/siteandbuildscripts/check_new_transcribed_sermons.py",
    "sermons:download:sample": "python scripts/siteandbuildscripts/download_missing_sermon_sample.py",
    "sermons:download": "python scripts/siteandbuildscripts/download_all_missing_sermons.py",
    "sermons:import": "python scripts/siteandbuildscripts/import_cleaned_sermons.py",
    "dist": "npm run build && electron-builder --win",
    "release": "node scripts/release.mjs",
    "e2e": "playwright test",
    "pree2e": "vite build --mode=test"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@tailwindcss/vite": "^4.0.4",
    "antd": "^5.20.6",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.1.8",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.42.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.35",
    "postcss-import": "^16.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "pnpm": {
    "overrides": {
      "builder-util-runtime": "9.5.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
